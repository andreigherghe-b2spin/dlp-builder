{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --name-only)",
      "Bash(git log --oneline -20)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(find . -maxdepth 4 -type f)",
      "Bash(pnpm build)",
      "Bash(pnpm test)",
      "Bash(pnpm lint)",
      "Bash(pnpm dev)",
      "Bash(pnpm changeset)",
      "Bash(pnpm --filter * build)",
      "Bash(pnpm --filter * test)",
      "Bash(pnpm --filter * lint)",
      "Bash(pnpm --filter * dev)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf .*)",
      "Bash(sudo *)",
      "Bash(chmod -R 777 *)",
      "Bash(chown -R *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(pnpm publish*)",
      "Bash(pnpm publish-versions*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*secret*)",
      "Read(**/*.token)",
      "Read(**/*.token.*)",
      "Read(**/token)",
      "Read(**/.token)",
      "Read(**/*_token)",
      "Read(**/*-token)",
      "Read(**/*_token.*)",
      "Read(**/*-token.*)",
      "Read(**/*Token)",
      "Read(**/*Token.*)",
      "Read(**/*credential*)",
      "Read(**/gha-creds-*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)"
    ]
  }
}
