# Branch name first: it is the cheapest check, and renaming a branch is far
# easier before it reaches the remote and grows a PR.
sh scripts/git-hooks/check-branch-name.sh
#
# Then everything CI checks, in cheapest-first order: format, lint, typecheck,
# build, unit tests, visual tests. Same script CI runs, so a green push is a
# green run.
#
# The visual step needs Playwright's Chromium and takes the bulk of the time.
# Skip the whole gate for a work-in-progress push with:
#   HUSKY=0 git push
pnpm check
