{
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindFunctions": ["cn", "cva", "clsx", "twMerge"],
  "tailwindStylesheet": "./apps/storybook-web/.storybook/global.css",
  "overrides": [
    {
      "files": ["packages/uikit-native/**", "apps/storybook-native/**"],
      "options": {
        "tailwindStylesheet": "./apps/storybook-native/src/global.css"
      }
    }
  ]
}
