{
  "name": "storybook-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.lint.json",
    "test": "vitest run --config vitest.guard.config.ts",
    "test:visual": "node playwright/scripts/run-tag-tests.js",
    "test:visual:update": "node playwright/scripts/run-tag-tests.js --update-snapshots=changed",
    "test:visual:report": "node playwright/scripts/show-latest-report.js"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@fontsource/radio-canada": "5.3.0",
    "@fontsource/ubuntu": "5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@ui/themes": "workspace:*",
    "@ui/web": "workspace:*",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.11.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.72.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-themes": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@types/node": "^24.12.2",
    "@types/react": "catalog:",
    "@types/react-dom": "^19.2.3",
    "@ui/eslint-config": "workspace:*",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.4",
    "playwright": "1.60.0",
    "storybook": "^10.3.5",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.28.0"
  }
}
