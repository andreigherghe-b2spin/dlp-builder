{
  "name": "uikit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "install-deps": "pnpm dlx google-artifactregistry-auth --verbose || { echo \"Artifactregistry auth failed\"; exit 1; } && pnpm i",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=storybook-web...",
    "dev:native": "turbo run dev --filter=storybook-native...",
    "dev:web:link": "node scripts/dev-link.mjs",
    "lint": "turbo run lint && eslint .",
    "lint:fix": "turbo run lint:fix && eslint . --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "coverage": "pnpm --filter @ui/web test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm visual",
    "visual": "pnpm --filter storybook-web test:visual",
    "visual:update": "pnpm --filter storybook-web test:visual:update",
    "visual:report": "pnpm --filter storybook-web test:visual:report",
    "changeset": "changeset",
    "publish-versions": "pnpm dlx google-artifactregistry-auth && node scripts/publish-versions.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@types/node": "catalog:",
    "@ui/eslint-config": "workspace:*",
    "eslint": "^9.39.4",
    "husky": "9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.9.5",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-native": "0.83.6",
    "@types/react": "19.2.14"
  }
}
